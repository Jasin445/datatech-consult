# Datatechhub Consulting — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# Placeholders below are NOT real credentials.

# --- Launch-only: canonical production URL (used for sitemap, canonical URLs, Open Graph) ---
# Example format: https://www.example.com  (no trailing slash). Must be set at BUILD time.
# Without it every page is noindex, robots.txt blocks crawling and the sitemap is empty (safe for previews).
NEXT_PUBLIC_SITE_URL=

# --- Feature: enquiry form (/api/contact). All four are required for the form to accept submissions. ---
# In production the form ALSO stays disabled until the privacy notice (src/content/privacy.ts) is "approved".
# Provider adapter to use. Supported: resend
# The sender address must be verified with the provider.
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Inbox that receives enquiries (must be a verified Datatechhub address)
CONTACT_RECIPIENT_EMAIL=
# Verified sender address for the provider
CONTACT_SENDER_EMAIL=

# --- Feature: consultation booking (/book-consultation) ---
# Provider-approved booking link (HTTPS). Leave blank to show the unconfigured state.
# Google Calendar appointment schedule: use the address from Share > Website embed (iframe src), e.g.
#   https://calendar.google.com/calendar/appointments/schedules/XXXX?gv=true  -> embedded on the page.
# Calendly (calendly.com/...) and Cal.com (cal.com/...) links are embedded too; any other HTTPS link opens in a new tab.
NEXT_PUBLIC_BOOKING_URL=

# --- Optional: verified public contact details (omitted from the footer when blank) ---
# NEXT_PUBLIC_* values are read at BUILD time for static pages (footer, homepage): set them before `npm run build`.
# Recommended for launch: a public email gives visitors a working contact path even before the form is enabled.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PARENT_BRAND_URL=
